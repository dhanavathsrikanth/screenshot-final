      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start building",
            "pages": [
              "index",
              "quickstart",
              "authentication",
              "responses"
            ]
          },
          {
            "group": "Control your capture",
            "pages": [
              "capture/viewport",
              "capture/full-page",
              "capture/formats",
              "capture/readiness",
              "capture/page-controls",
              "capture/localization",
              "capture/inspection"
            ]
          },
          {
            "group": "Build a reliable integration",
            "pages": [
              "integration/async-jobs",
              "integration/idempotency",
              "integration/webhooks",
              "integration/credits-and-limits",
              "integration/node",
              "integration/python"
            ]
          },
          {
            "group": "AI agents",
            "pages": [
              "agents/mcp",
              "agents/oauth"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "errors"
            ]
          },
          {
            "group": "Contract reference",
            "pages": [
              "reference/devices",
              "reference/error-codes"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
