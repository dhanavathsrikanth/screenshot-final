{
  "name": "@screenshotapi/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname localhost",
    "prebuild": "pnpm --filter @screenshotapi/brand --filter @screenshotapi/contracts --filter @screenshotapi/database --filter @screenshotapi/engine --filter @screenshotapi/queue --filter @screenshotapi/storage run build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 .test-dist/lib/*.test.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.8",
    "@dodopayments/nextjs": "^0.3.1",
    "@screenshotapi/brand": "workspace:*",
    "@screenshotapi/contracts": "workspace:*",
    "@screenshotapi/database": "workspace:*",
    "@screenshotapi/engine": "workspace:*",
    "@screenshotapi/queue": "workspace:*",
    "@screenshotapi/storage": "workspace:*",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "next": "^16.0.3",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.2"
  }
}
