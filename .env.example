# Neon / Postgres
# Pooled (transaction mode) — use this for all runtime queries from apps and workers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?channel_binding=require&sslmode=verify-full

# Direct (no pooler) — required for migrations and DDL. Session state is preserved here.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full
DATABASE_POOL_IDLE_TIMEOUT_MS=120000

# Neon identifiers, for the Neon serverless driver and branch-based tooling
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_REGION=

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=http://localhost:3000
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO=
DODO_PRODUCT_SCALE=
DODO_PRODUCT_CREDITS_10K=
DODO_PRODUCT_CREDITS_50K=
DODO_PRODUCT_CREDITS_250K=
DODO_PRODUCT_STARTER_2026_10=
DODO_PRODUCT_PRO_2026_10=
DODO_PRODUCT_GROWTH_2026_10=
DODO_PRODUCT_CREDITS_1K_2026_10=
DODO_PRODUCT_CREDITS_5K_2026_10=
DODO_PRODUCT_CREDITS_20K_2026_10=

# S3-compatible storage (Cloudflare R2 or another S3 provider)
STORAGE_ACCOUNT_ID=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_CDN_BASE_URL=
STORAGE_FORCE_PATH_STYLE=

# Redis / BullMQ
# For Upstash, set UPSTASH_REDIS_URL to the rediss:// URL from Connect > TCP.
# BullMQ needs the TCP URL; UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are not queue connections.
REDIS_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SCREENSHOTAPI_LOCAL_CAPTURE=0
SCREENSHOTAPI_API_URL=
CAPTURE_INTENT_ENCRYPTION_KEY=
CAPTURE_INTENT_PREVIOUS_KEYS=

# Queue tuning. Sync timeout is capped at 2000ms by the package; the rest are defaults.
SCREENSHOTAPI_QUEUE_CONCURRENCY=
SCREENSHOTAPI_QUEUE_ATTEMPTS=
SCREENSHOTAPI_SYNC_TIMEOUT_MS=
SCREENSHOTAPI_WEBHOOK_ALLOW_PRIVATE_HOSTS=
